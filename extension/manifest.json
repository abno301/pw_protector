{
  "manifest_version": 3,
  "name": "My Autofill Extension",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///"],
      "js": ["content.js"],
      "css": ["modal.css"]
    }
  ]
}
